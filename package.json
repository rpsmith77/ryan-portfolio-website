{
  "name": "ryan-portfolio-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "5.4.5"
  },
  "overrides": {
    "sharp": "$sharp",
    "next": {
      "postcss": "8.5.25"
    }
  },
  "allowScripts": {
    "unrs-resolver@1.11.1": true
  },
  "engines": {
    "node": "24.x"
  }
}
